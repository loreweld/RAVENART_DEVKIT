{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DEVKIT meta.yaml Schema",
  "type": "object",
  "required": ["metadata", "system", "architecture"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "authored", "note"],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "authored": { "type": "string", "format": "date" },
        "note": { "type": "string" }
      }
    },
    "system": {
      "type": "object",
      "required": ["name", "version", "description"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "architecture": {
      "type": "object",
      "required": ["layers", "dependency_chain"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "responsibility"],
            "properties": {
              "name": { "type": "string" },
              "responsibility": { "type": "string" }
            }
          }
        },
        "dependency_chain": { "type": "string" }
      }
    },
    "boot_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "file", "note"],
        "properties": {
          "step": { "type": "string" },
          "file": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "source": { "type": "string" },
          "handlers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "design_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "note": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "message_flow": {
      "type": "object",
      "properties": {
        "entry": { "type": "string" },
        "decision_layer": { "type": "string" },
        "fast_path": { "type": "string" },
        "slow_path": { "type": "string" },
        "cancel": { "type": "string" }
      }
    },
    "memory_flow": {
      "type": "object",
      "properties": {
        "storage": { "type": "string" },
        "write_path": { "type": "string" },
        "query_path": { "type": "string" },
        "memory_types": { "type": "array", "items": { "type": "string" } }
      }
    },
    "session_flow": {
      "type": "object",
      "properties": {
        "lifecycle": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "component"],
        "properties": {
          "capability": { "type": "string" },
          "component": { "type": "string" }
        }
      }
    },
    "data_flow_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "startup_chain": {
      "type": "object",
      "properties": {
        "steps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "shutdown_chain": {
      "type": "object",
      "properties": {
        "steps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}